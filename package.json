{
  "name": "linkit-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit",
    "dev:cli": "bun run packages/cli/src/index.ts",
    "dev:local-mcp": "bun run packages/local-mcp/src/index.ts",
    "dev:remote-mcp": "bun run apps/remote-mcp/src/index.ts",
    "build:core": "bun run --filter @jaimeng168/linkit-core build",
    "build:cli": "bun run --filter @jaimeng168/linkit build",
    "build:local-mcp": "bun run --filter @jaimeng168/linkit-mcp build",
    "release:pack:core": "bun run --filter @jaimeng168/linkit-core pack:dry",
    "release:pack:cli": "bun run --filter @jaimeng168/linkit pack:dry",
    "release:pack:local-mcp": "bun run --filter @jaimeng168/linkit-mcp pack:dry"
  },
  "dependencies": {
    "prettier": "^3.8.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1"
  }
}
